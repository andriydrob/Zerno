---
const hours = [
  { day: 'Понеділок – П\'ятниця', time: '8:00 – 20:00' },
  { day: 'Субота – Неділя', time: '9:00 – 20:00' }
];
---

<section id="location" class="border-t border-line">
  <div class="max-w-content mx-auto px-6 md:px-10 py-20 md:py-28">
    <p class="section-label mb-4">Локація</p>
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-start">
      <div>
        <h2 class="text-3xl md:text-[2.5rem] leading-tight text-coffee-dark mb-8">
          Заходьте, ми поруч
        </h2>
        <dl class="space-y-6 text-[17px]">
          <div>
            <dt class="text-sm text-ink/50 mb-1">Адреса</dt>
            <dd>вул. Січових Стрільців, 12, Київ</dd>
          </div>
          <div>
            <dt class="text-sm text-ink/50 mb-1">Години роботи</dt>
            <dd class="space-y-1">
              {hours.map((row) => (
                <div class="flex justify-between max-w-xs">
                  <span class="text-ink/70">{row.day}</span>
                  <span>{row.time}</span>
                </div>
              ))}
            </dd>
          </div>
          <div>
            <dt class="text-sm text-ink/50 mb-1">Контакти</dt>
            <dd>
              <a href="tel:+380441234567" class="hover:text-coffee-dark underline underline-offset-4 decoration-line">
                +38 (044) 123-45-67
              </a>
              <br />
              <a href="mailto:hello@zerno.coffee" class="hover:text-coffee-dark underline underline-offset-4 decoration-line">
                hello@zerno.coffee
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-2xl overflow-hidden border border-line aspect-[4/3] md:aspect-auto md:h-full">
        <iframe
          title="Мапа розташування Зерно"
          src="https://maps.google.com/maps?q=Kyiv%2C%20Sichovykh%20Striltsiv%2012&t=&z=15&ie=UTF8&iwloc=&output=embed"
          class="w-full h-full min-h-[320px] grayscale contrast-125"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
