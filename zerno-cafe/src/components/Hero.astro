<section id="home" class="max-w-content mx-auto px-6 md:px-10 pt-16 pb-20 md:pt-24 md:pb-28">
  <div class="grid md:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
    <div class="animate-rise">
      <p class="section-label mb-5">Кав'ярня по сусідству · Київ</p>
      <h1 class="text-[2.75rem] leading-[1.05] md:text-6xl md:leading-[1.03] font-medium text-coffee-dark text-balance">
        Кава, зварена так,<br />
        як у вас удома<br />
        часу на це <em class="not-italic text-moss-dark">немає</em>.
      </h1>
      <p class="mt-7 max-w-md text-[17px] leading-relaxed text-ink/75">
        Зерно смажимо самі невеликими партіями, хліб і десерти пече сусідня
        пекарня щоранку. Заходьте на каву перед роботою або на тиху годину
        з книжкою після.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#menu"
          class="inline-flex items-center rounded-full bg-coffee px-6 py-3 text-[15px] text-paper hover:bg-coffee-dark transition-colors"
        >
          Переглянути меню
        </a>
        <a
          href="#location"
          class="inline-flex items-center rounded-full border border-ink/20 px-6 py-3 text-[15px] hover:border-ink/40 transition-colors"
        >
          Вул. Січових Стрільців, 12
        </a>
      </div>
    </div>

    <div class="hidden md:block" aria-hidden="true">
      <svg viewBox="0 0 280 320" class="w-full max-w-xs mx-auto text-coffee-dark">
        <path
          d="M60 120 h160 l-14 130 a20 20 0 0 1-20 18 H94 a20 20 0 0 1-20-18 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
        />
        <path
          d="M220 135 c34 0 34 52 0 52"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
        />
        <path
          d="M96 100 c-6-18 10-24 6-40 M140 100 c-6-22 12-28 6-46 M184 100 c-6-18 10-24 6-40"
          fill="none"
          stroke="#7C8B6F"
          stroke-width="3"
          stroke-linecap="round"
        />
        <line x1="70" y1="95" x2="210" y2="95" stroke="currentColor" stroke-width="3" />
      </svg>
    </div>
  </div>
</section>
