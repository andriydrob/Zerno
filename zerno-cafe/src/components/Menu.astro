---
import MenuSection from './MenuSection.tsx';
---

<section id="menu" class="border-t border-line bg-coffee-dark text-paper">
  <div class="max-w-content mx-auto px-6 md:px-10 py-20 md:py-28">
    <p class="section-label mb-4 !text-paper/60">Меню</p>
    <h2 class="text-3xl md:text-[2.5rem] leading-tight mb-12 max-w-xl">
      Коротке меню, бо все, що в ньому, — те, що ми самі п'ємо щодня
    </h2>
    <div class="menu-on-dark">
      <MenuSection client:load />
    </div>
  </div>
</section>

<style>
  .menu-on-dark :global([role='tab']) {
    border-color: rgba(243, 239, 230, 0.25);
    color: rgba(243, 239, 230, 0.7);
  }
  .menu-on-dark :global([role='tab'][aria-selected='true']) {
    background-color: #f3efe6;
    color: #3e271b;
    border-color: #f3efe6;
  }
  .menu-on-dark :global([role='tabpanel'] p:first-child) {
    color: #f3efe6;
  }
  .menu-on-dark :global([role='tabpanel'] p:last-child) {
    color: rgba(243, 239, 230, 0.55);
  }
  .menu-on-dark :global([role='tabpanel'] span) {
    color: #cdd6c4;
  }
  .menu-on-dark :global([role='tabpanel'] li) {
    border-color: rgba(243, 239, 230, 0.15);
  }
</style>
