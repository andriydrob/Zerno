---
const links = [
  { href: '#home', label: 'Головна' },
  { href: '#about', label: 'Про нас' },
  { href: '#menu', label: 'Меню' },
  { href: '#location', label: 'Локація' }
];
---

<header class="sticky top-0 z-40 bg-paper/90 backdrop-blur border-b border-line">
  <nav class="max-w-content mx-auto flex items-center justify-between px-6 py-4 md:px-10">
    <a href="#home" class="font-display text-xl tracking-tight text-coffee-dark">
      Зерно
    </a>
    <ul class="hidden md:flex items-center gap-8 text-[15px]">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="relative py-1 text-ink/80 hover:text-ink transition-colors after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0 after:bg-coffee after:transition-all hover:after:w-full"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="#location"
      class="hidden md:inline-flex items-center rounded-full bg-coffee px-5 py-2 text-sm text-paper hover:bg-coffee-dark transition-colors"
    >
      Як нас знайти
    </a>
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer text-ink/80 px-2 py-1">Меню</summary>
      <ul class="absolute right-0 mt-2 w-44 rounded-xl border border-line bg-paper p-2 shadow-sm">
        {links.map((link) => (
          <li>
            <a href={link.href} class="block rounded-lg px-3 py-2 text-sm hover:bg-line/40">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
